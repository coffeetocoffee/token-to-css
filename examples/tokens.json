{
  "color": {
    "primary": "#3b82f6",
    "primaryHover": "#2563eb",
    "background": "#ffffff",
    "text": "#0f172a",
    "danger": "#ef4444"
  },
  "spacing": {
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "{spacing.md} * 1.5",
    "xl": "2rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.75rem",
    "pill": "9999px"
  },
  "font": {
    "family": {
      "sans": "system-ui, sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "size": {
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.25rem"
    }
  },
  "shadow": {
    "md": "0 4px 6px rgba(0,0,0,0.1)"
  }
}
