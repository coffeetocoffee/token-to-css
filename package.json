{
  "name": "token-to-css",
  "version": "17.0.0",
  "description": "Convert design token JSON files into framework-agnostic CSS (custom properties, SCSS, or barefoot-css).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeetocoffee/token-to-css.git"
  },
  "homepage": "https://github.com/coffeetocoffee/token-to-css#readme",
  "bugs": {
    "url": "https://github.com/coffeetocoffee/token-to-css/issues"
  },
  "bin": {
    "token-to-css": "src/cli.js"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./core.js": "./src/core.js",
    "./schema.js": "./src/schema.js",
    "./locate.js": "./src/locate.js",
    "./serve.js": "./src/serve.js",
    "./client.js": "./src/client.js",
    "./registry.js": "./src/registry.js",
    "./governance.js": "./src/governance.js",
    "./migrate.js": "./src/migrate.js",
    "./federation.js": "./src/federation.js",
    "./namespaces.js": "./src/namespaces.js",
    "./relay.js": "./src/relay.js",
    "./mcp.js": "./src/mcp.js",
    "./metrics.js": "./src/metrics.js",
    "./playground.js": "./src/playground.js",
    "./connectors/figma.js": "./src/connectors/figma.js",
    "./connectors/storybook.js": "./src/connectors/storybook.js",
    "./connectors/github.js": "./src/connectors/github.js",
    "./connectors/cms.js": "./src/connectors/cms.js",
    "./connectors/flutter.js": "./src/connectors/flutter.js",
    "./connectors/compose.js": "./src/connectors/compose.js",
    "./connectors/index.js": "./src/connectors/index.js",
    "./editor.js": "./src/editor.js",
    "./presets/barefoot.js": "./src/presets/barefoot.js",
    "./presets/tailwind.js": "./src/presets/tailwind.js",
    "./presets/open-props.js": "./src/presets/open-props.js"
  },
  "files": [
    "src",
    "schema"
  ],
  "workspaces": [
    "packages/core",
    "packages/connectors",
    "packages/eslint-plugin",
    "packages/stylelint-plugin"
  ],
  "dependencies": {
    "@token-to-css/core": "17.0.0",
    "@token-to-css/connectors": "17.0.0"
  },
  "scripts": {
    "example": "node src/cli.js examples/tokens.json -o examples/output.css",
    "test": "node --test",
    "check:syntax": "node scripts/check-syntax.js",
    "check:declarations": "node scripts/check-declarations.js",
    "check:coverage": "node scripts/check-coverage.js",
    "check": "npm run check:syntax && npm run check:declarations && npm test",
    "verify": "npm run check && npm run check:coverage",
    "bench": "node scripts/bench-v13.js",
    "hooks:install": "node scripts/install-hooks.js",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
